# ---------------------------------------------------------------------------
# Site institucional Lottopag — variáveis de ambiente
# Copie para .env.local e preencha. Nenhuma é obrigatória para rodar localmente.
# ---------------------------------------------------------------------------

# Domínio de publicação (com protocolo). Enquanto vazio:
#   - canonical e sitemap não são emitidos;
#   - robots.txt e a meta robots bloqueiam a indexação.
# A proposta citava www.lottopay.net.br; com a marca Lottopag, o domínio ainda precisa ser confirmado.
NEXT_PUBLIC_SITE_URL=

# Destino do formulário de contato (POST JSON). Pode ser um CRM, uma automação
# (Zapier, Make, n8n) ou uma API própria. Enquanto vazio, o formulário valida os
# campos e informa ao visitante que o envio ainda não está ativo — não simula sucesso.
CONTACT_WEBHOOK_URL=

# Opcional: token enviado como "Authorization: Bearer <token>" para o webhook.
CONTACT_WEBHOOK_TOKEN=

# Contatos comerciais oficiais e verificados. Só aparecem no site quando preenchidos
# (rodapé e alternativa exibida quando o formulário não consegue enviar).
COMMERCIAL_EMAIL=
COMMERCIAL_PHONE=
