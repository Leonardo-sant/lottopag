# ---------------------------------------------------------------------------
# Site institucional Lottopag — variáveis de ambiente
# Copie para .env.local e preencha. Nenhuma é obrigatória para rodar localmente.
# ---------------------------------------------------------------------------

# Domínio de publicação (com protocolo). Enquanto vazio:
#   - canonical e sitemap não são emitidos;
#   - robots.txt e a meta robots bloqueiam a indexação.
# A proposta citava www.lottopay.net.br; com a marca Lottopag, o domínio ainda precisa ser confirmado.
NEXT_PUBLIC_SITE_URL=

# Subcaminho de publicação. No GitHub Pages sem domínio próprio (leonardo-sant.github.io/lottopag)
# o workflow já usa "/lottopag". Localmente e com domínio próprio, deixe vazio.
NEXT_PUBLIC_BASE_PATH=

# Destino do formulário de contato. O site é estático, então o envio sai do navegador:
# use um serviço que aceite POST JSON do navegador (Formspree, Getform, Basin, webhook com
# CORS liberado). Esta URL fica pública; não use endpoints que exijam segredo.
# Enquanto vazio, o formulário valida os campos e informa que o envio ainda não está ativo.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Contatos comerciais oficiais e verificados. Só aparecem no site quando preenchidos
# (rodapé e alternativa exibida quando o formulário não consegue enviar).
COMMERCIAL_EMAIL=
COMMERCIAL_PHONE=
